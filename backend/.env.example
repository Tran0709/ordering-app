# Copy this file to .env and fill it in. Never commit .env or share it.

# --- required ---
# Long random text used to sign staff logins. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Password staff use at /staff/login
STAFF_PASSWORD=

# The address customers use, e.g. https://order.caiyuanzi.sg (used for payment return links and webhooks)
PUBLIC_URL=http://localhost:5050
# Where orders are stored (default: orders.db next to app.py)
DATABASE=

# --- payments: demo | hitpay | stripe ---
PAYMENT_PROVIDER=demo

# HitPay (dashboard → Settings → Payment Gateway → API Keys). Keep HITPAY_SANDBOX=1 until tested.
HITPAY_API_KEY=
HITPAY_SALT=
HITPAY_SANDBOX=1

# Stripe (dashboard → Developers → API keys / Webhooks). Use sk_test_… keys until tested.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- new-order notifications (optional; orders are always visible at /staff) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ORDER_EMAIL_TO=

# Testing only: accept orders outside opening hours
IGNORE_HOURS=
